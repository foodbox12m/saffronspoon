# Base URL of the saffron & spoon order API (no trailing slash).
# Leave empty to run the app in WhatsApp-fallback mode (static hosting, no backend).
VITE_API_BASE_URL=https://saffronspoon-api.onrender.com

# Business Zelle ID shown on the payment screen.
VITE_ZELLE_ID=orders@saffronandspoon.com

# WhatsApp number in international format, digits only (no +, spaces or dashes).
# Used to build wa.me deep links for the fallback order flow.
VITE_WHATSAPP_NUMBER=15103999156
