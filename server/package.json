{
  "name": "saffronspoon-server",
  "version": "1.0.0",
  "private": true,
  "description": "Agentic AI catering ordering server for saffron & spoon — MCP tool layer, WhatsApp agent, Zelle reconciliation.",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "tsx src/mcp/server.ts",
    "ingest:ubereats": "tsx src/kb/ingest-ubereats.ts",
    "test": "node --test --import tsx dist-test/noop.js 2>/dev/null || tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.11",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
