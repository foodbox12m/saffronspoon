# ─────────────────────────────────────────────────────────────────────────────
# saffron & spoon — server environment
#
# Copy to .env and fill in. Never commit .env.
# In production the server refuses to boot if a starred (*) value is missing.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080

# Public URL of THIS server. Used to build QR targets and to validate the
# Twilio webhook signature — if it is wrong, signature validation always fails.
PUBLIC_BASE_URL=http://localhost:8080

# Where the customer-facing React app lives (GitHub Pages or Vercel).
WEB_APP_URL=https://foodbox12m.github.io/saffronspoon/app/


# ── Security ─────────────────────────────────────────────────────────────────
# * Signing key for access tokens. Must be 32+ characters in production.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this instantly invalidates every issued token.
JWT_SECRET=

JWT_ISSUER=saffronspoon
JWT_AUDIENCE=saffronspoon-agent

# Token lifetime in seconds. Short by design; the web app re-issues silently.
ACCESS_TOKEN_TTL_SECONDS=900

# * Shared code staff type in to reach the payment-verification screen.
# Give it the same weight as a password: long, random, rotated when someone leaves.
STAFF_ACCESS_CODE=

# Comma-separated origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:5173,https://foodbox12m.github.io

# Rate limiting, per identity.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
# Tighter budget for the expensive agent loop.
AGENT_RATE_LIMIT_MAX_REQUESTS=12
# Hard ceiling on tool calls the agent may make while serving one message.
MAX_TOOL_CALLS_PER_TURN=8


# ── Zelle ────────────────────────────────────────────────────────────────────
# * The email or phone number enrolled with Zelle at your bank.
ZELLE_ID=orders@saffronspoon.example

# Name the customer sees in their banking app. Must match your Zelle enrollment
# exactly, or customers will think they are paying the wrong business.
ZELLE_RECIPIENT_NAME=saffron & spoon

# Deposit percentage required to lock an event date. 100 = pay in full up front.
DEPOSIT_PERCENT=50


# ── Pricing ──────────────────────────────────────────────────────────────────
# Sales tax in basis points: 938 = 9.375% (Santa Clara County, CA).
# Verify your own rate — this is the number that ends up on the customer's total.
TAX_BASIS_POINTS=938

# Flat delivery fee in cents. 0 disables it.
DELIVERY_FEE_CENTS=0
# Orders at or above this subtotal get free delivery.
FREE_DELIVERY_THRESHOLD_CENTS=50000


# ── WhatsApp ─────────────────────────────────────────────────────────────────
# twilio | baileys | none    ("none" logs replies to the console — good for dev)
WHATSAPP_PROVIDER=none

# Business number in E.164 (digits only is fine) for the wa.me link.
WHATSAPP_BUSINESS_NUMBER=14085551234

# --- Twilio (WHATSAPP_PROVIDER=twilio) ---
# console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your WhatsApp-enabled sender, e.g. +14155238886 for the sandbox.
TWILIO_WHATSAPP_FROM=
# Leave true. Setting false accepts unsigned webhooks — anyone with the URL
# could then impersonate a customer and place orders.
TWILIO_VALIDATE_SIGNATURE=true

# --- Baileys (WHATSAPP_PROVIDER=baileys) ---
# Needs a persistent disk. Losing this directory means re-scanning the QR code.
BAILEYS_AUTH_DIR=./.baileys-auth

# Numbers alerted on new orders and payment claims (comma-separated, E.164).
ADMIN_NOTIFY_NUMBERS=


# ── Database (Supabase) ──────────────────────────────────────────────────────
# Leave blank to run on the in-memory store: everything works, but all orders
# are lost on restart. Fine for a demo, not for taking real money.
SUPABASE_URL=
# * Service-role key. SERVER ONLY — it bypasses row-level security.
# Never put this in the frontend or in any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROOF_BUCKET=payment-proofs


# ── Agent (optional) ─────────────────────────────────────────────────────────
# Any OpenAI-compatible chat completions endpoint. Without a key the agent still
# works, falling back to deterministic scripted replies instead of an LLM.
AGENT_API_KEY=
AGENT_API_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.2
AGENT_MAX_OUTPUT_TOKENS=700


# ── Ops ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
